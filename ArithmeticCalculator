import java.util.Scanner;
public class Calculator {
    public static void calculator(int a, int b, int choice){
        if(choice == 1){
            System.out.println("Sum of given number is "+a+b);
        }
        else if(choice ==2){
            System.out.println("Difference of given number is "+ (a-b));
        }
        else if(choice ==3){
            System.out.println("The product of given number is "+ a*b);
        }
        else if(choice ==4){
            System.out.println("For quotient "+a/b);
        }
        else if(choice ==5){
            System.out.println("For reminder "+a%b);
        }
        else{
            System.out.println("Enter a valid choice....");
        }
    }
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        System.out.print("Enter first number which is greater than other : ");
        int a = sc.nextInt();
        System.out.print("Enter the second number : ");
        int b = sc.nextInt();
        System.out.println("Enter a choice 1 for add 2 for subtraction 3 for production 4 for quotient 5 for remainder : ");
        int choice = sc.nextInt();
        calculator(a, b, choice);
        sc.close();
    }
}
